{
    "name": "@abstractplay/renderer",
    "version": "1.0.0-beta",
    "description": "Renders Abstract Play game states graphically",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "AbstractPlay/renderer"
    },
    "main": "build/index.js",
    "types": "build/index.d.ts",
    "files": [
        "build/**/*.js",
        "build/**/*.js.map",
        "build/**/*.d.ts",
        "build/**/*.json",
        "LICENSE"
    ],
    "exports": {
        ".": {
            "types": "./build/index.d.ts",
            "import": "./build/index.js"
        },
        "./build/schemas/schema": {
            "types": "./build/schemas/schema.d.ts"
        },
        "./build/renderers/_base": {
            "types": "./build/renderers/_base.d.ts"
        }
    },
    "scripts": {
        "build": "npm run build-ts && npm run test:postbuild && npm run lint && npm pack",
        "build-ts": "npm run json2ts && node scripts/patch-honeycomb-grid-dts.mjs && rimraf build && tsc && shx mkdir -p build/schemas && shx cp ./src/schemas/schema.d.ts ./build/schemas",
        "typecheck": "node scripts/patch-honeycomb-grid-dts.mjs && tsc --noEmit",
        "pretest": "npm run typecheck",
        "test:postbuild": "node scripts/smoke-package-entry.mjs && node scripts/check-npm-pack.mjs",
        "test": "mocha",
        "test:bundle": "mocha test/bundle-exports.test.ts",
        "test:browser": "npm run dist-dev && playwright test",
        "test:browser:install": "playwright install --with-deps chromium firefox webkit",
        "playground": "vite --config playground/vite.config.ts",
        "contact-sheet": "tsx bin/contact-export.ts",
        "lint": "npx eslint .",
        "dist-dev": "rimraf dist && vite build --config playground/vite.config.ts && vite build --config playground/vite.aprender.config.ts",
        "dist-prod": "rimraf dist && vite build --config playground/vite.config.ts --mode production && vite build --config playground/vite.aprender.config.ts --mode production",
        "json2ts": "npx json2ts -i src/schemas/schema.json -o src/schemas/schema.d.ts",
        "full-dev": "npm run test && npm run build && npm run dist-dev && npm run deploy",
        "full-prod": "npm run test && npm run build && npm run dist-prod && npm run deploy",
        "deploy": "npx serverless client deploy --no-confirm && aws s3 cp ./dist/APRender.min.js s3://gameslib.dev.abstractplay.com --profile AbstractPlayDev --cache-control no-cache",
        "deploy:ci": "npx serverless client deploy --no-confirm && aws s3 cp ./dist/APRender.min.js s3://gameslib.dev.abstractplay.com --cache-control no-cache"
    },
    "author": "Aaron Dalton <aaron@daltons.ca> (https://www.perlkonig.com)",
    "license": "MIT",
    "engines": {
        "node": ">=24",
        "npm": "11.6.2"
    },
    "packageManager": "npm@11.6.2",
    "keywords": [
        "abstractplay",
        "svg"
    ],
    "dependencies": {
        "@svgdotjs/svg.js": "3.2.5",
        "@turf/union": "^6.5.0",
        "@types/fnv-plus": "^1.3.2",
        "ajv": "^8.12.0",
        "color-convert": "^2.0.1",
        "fnv-plus": "^1.3.1",
        "graphology": "^0.26.0",
        "honeycomb-grid": "^4.1.5",
        "json-stringify-deterministic": "^1.0.12",
        "monotone-chain-convex-hull": "^1.1.0",
        "tinycolor2": "^1.6.0",
        "transformation-matrix-js": "github:epistemex/transformation-matrix-js",
        "uuid": "^9.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.26.0",
        "@playwright/test": "^1.51.0",
        "@resvg/resvg-js": "^2.6.2",
        "@types/chai": "^4.3.4",
        "@types/color-convert": "^2.0.3",
        "@types/geojson": "^7946.0.14",
        "@types/mocha": "^10.0.10",
        "@types/tinycolor2": "^1.4.6",
        "@types/uuid": "^9.0.1",
        "@types/yargs": "^17.0.24",
        "@typescript-eslint/eslint-plugin": "^8.32.0",
        "@typescript-eslint/parser": "^8.32.0",
        "chai": "^4.3.7",
        "dejavu-fonts-ttf": "^2.37.3",
        "eslint": "^9.26.0",
        "eslint-config-prettier": "^10.1.3",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-prefer-arrow": "^1.2.3",
        "eslint-plugin-tsdoc": "^0.2.17",
        "eslint-plugin-unicorn": "^59.0.1",
        "json-schema-to-typescript": "^15.0.4",
        "mocha": "^11.2.2",
        "moment": "^2.29.4",
        "rimraf": "^5.0.1",
        "serverless": "^3.40.0",
        "serverless-finch": "^4.0.3",
        "shx": "^0.4.0",
        "svgdom": "^0.1.14",
        "tsx": "^4.20.6",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.32.0",
        "vite": "^6.3.5",
        "yargs": "^17.7.2"
    },
    "eslintIgnore": [
        "src/schemas/*"
    ]
}
